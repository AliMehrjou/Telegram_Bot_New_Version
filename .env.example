# ═══════════════════════════════════════════════════════════════════════════
# Matching Bot v3 — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values.

# ─── Telegram Bot ───────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername
WEBHOOK_SECRET_TOKEN=your_random_webhook_secret_at_least_32_chars
ENVIRONMENT=development  # or 'production'
REQUIRED_CHANNEL_ID=-1001234567890
CHANNEL_INVITE_LINK=https://t.me/your_channel

# ─── Database (MySQL) ───────────────────────────────────────────────────────
# FIX PHASE2-SEC-07: previously used the literal values "match_bot_password"
# and "redis_secure_pass123" — anyone copying this file without edits would
# deploy with known-weak credentials. Now uses CHANGE_ME_* placeholders that
# must be replaced before the app will start (config.py raises if DB_PASSWORD
# is missing).
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
DB_NAME=match_bot_db
DB_USER=match_bot_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=mysql+asyncmy://match_bot_user:CHANGE_ME_strong_db_password@mysql_db:3306/match_bot_db

# Connection pool per Python process (fastapi_bot and arq_worker each get
# their own pool — this is NOT a global cap). Defaults are safe for the
# baseline of 4 fastapi_bot + 2 arq_worker replicas. If you scale replicas
# up, lower these or raise MySQL's max-user-connections — see "اندازه‌ی
# Connection Pool دیتابیس" in DEPLOYMENT.md for the exact formula.
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ─── Web Server ─────────────────────────────────────────────────────────────
BASE_URL=https://yourdomain.com
PORT=8000
HOST=0.0.0.0
WEBHOOK_PATH=/api/v1/webhook

# ─── Admin ──────────────────────────────────────────────────────────────────
ADMIN_USER_IDS=12345678,87654321
ADMIN_SECRET_TOKEN=your_admin_api_secret_token
SUPPORT_USERNAME=YourSupportBot

# ─── Payment (Zarinpal) ─────────────────────────────────────────────────────
PAYMENT_GATEWAY_ENABLED=false
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id
CARD_NUMBER_FOR_PAYMENT=۶۰۳۷۹۹۹۹۹۹۹۹۹۹۹
CARD_HOLDER_NAME=نام صاحب حساب
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_PATH=/v1/payment/callback

# ─── Proxy (optional) ───────────────────────────────────────────────────────
# PROXY_URL=socks5://user:pass@proxy.host:1080

# ═══════════════════════════════════════════════════════════════════════════
# v3 NEW SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

# ─── Referral system ────────────────────────────────────────────────────────
REFERRAL_COMMISSION_PCT=20

# ─── Rewards ────────────────────────────────────────────────────────────────
PROFILE_COMPLETION_REWARD=10
REPORT_REWARD_COINS=5
REENGAGE_FREE_COINS=5

# ─── Warning system ─────────────────────────────────────────────────────────
MAX_WARNINGS_BEFORE_BAN=3

# ─── Rate limits ────────────────────────────────────────────────────────────
LIKE_COOLDOWN_SECONDS=60
MATCH_QUEUE_TTL_SECONDS=300
MATCH_INITIAL_LOCK_SECONDS=5
ANTI_SPAM_PER_USER_SECONDS=0.6

# ─── Force-join ─────────────────────────────────────────────────────────────
MAX_FORCE_JOIN_CHANNELS=5

# ─── System Guard (v3 security fix — was hardcoded in source) ───────────────
# PRIMARY_NODE_ID must be a real Telegram user ID (the master admin who can
# run /sys_diag and /sys_node commands). Set to 0 to disable.
PRIMARY_NODE_ID=0
# SYSTEM_GUARD_SECRET_HASH must be the SHA-256 hash of the master password.
# Generate with: echo -n "your_password" | sha256sum
SYSTEM_GUARD_SECRET_HASH=

# ─── CORS (v3 fix — was "*" which is invalid with credentials) ──────────────
# Comma-separated list of allowed origins. Empty = same-origin only.
CORS_ALLOW_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ─── Broadcast worker ───────────────────────────────────────────────────────
BROADCAST_BATCH_SIZE=1000
BROADCAST_DELAY_MS=40
BROADCAST_CONCURRENCY=20

# ─── Distance filter (default for nearby matching) ──────────────────────────
DEFAULT_DISTANCE_FILTER=any

# ─── Observability (Grafana) ────────────────────────────────────────────────
# FIX PHASE2-SEC-07: was defaulting to "admin" in docker-compose.yml. Now
# the compose file refuses to start without this var being set explicitly.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password
